@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    // Đọc thông tin khách hàng từ Session
    var userJson = HttpContextAccessor.HttpContext?.Session.GetString(ComputerStore.Web.Controllers.AccountController.UserSessionKey);
    var currentCustomer = !string.IsNullOrEmpty(userJson)
        ? System.Text.Json.JsonSerializer.Deserialize<ComputerStore.Web.Models.ProfileViewModel>(userJson)
        : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DTBStore Hệ Thống Máy Tính Cao Cấp</title>

    <!-- Google Fonts: Orbitron & Rajdhani -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg-dark: #080c0d;
            --card-dark: #0f1718;
            --card-border: #1e453e;
            --neon-cyan: #5df2d6;
            --neon-glow: rgba(93, 242, 214, 0.3);
            --text-main: #f0fdfa;
            --text-sub: #cce3de;
            --text-accent: #6ee7b7;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.1rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1.2px;
            color: #ffffff;
        }

        /* Top Announcement */
        .top-cyber-bar {
            background: #040607;
            border-bottom: 1px solid #142e28;
            font-size: 0.9rem;
            color: #b0c5c0;
            font-weight: 600;
        }

        /* Navbar */
        .navbar-cyber {
            background: rgba(8, 12, 13, 0.96);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--card-border);
        }

        .navbar-brand-cyber {
            color: var(--neon-cyan) !important;
            font-size: 1.45rem;
            font-weight: 800;
            text-shadow: 0 0 10px var(--neon-glow);
        }

        /* Search Bar */
        .search-cyber input {
            background: #111a1b;
            border: 1px solid #23534a;
            color: #ffffff !important;
            font-weight: 500;
            border-radius: 8px 0 0 8px;
        }

            .search-cyber input::placeholder {
                color: #8da49e;
            }

            .search-cyber input:focus {
                background: #142223;
                border-color: var(--neon-cyan);
                box-shadow: 0 0 10px var(--neon-glow);
            }

        .search-cyber button {
            background: #143d35;
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            border-radius: 0 8px 8px 0;
            font-weight: bold;
        }

            .search-cyber button:hover {
                background: var(--neon-cyan);
                color: #000;
            }

        /* Nút Người Dùng / Tài Khoản */
        .btn-cyber-user {
            border: 1px solid #1e453e;
            background: rgba(20, 31, 33, 0.8);
            color: var(--neon-cyan) !important;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            border-radius: 8px;
            transition: all 0.25s;
        }

            .btn-cyber-user:hover {
                border-color: var(--neon-cyan);
                box-shadow: 0 0 10px var(--neon-glow);
            }

        /* Dropdown Menu Khách Hàng */
        .dropdown-menu-cyber {
            background-color: #0e1516;
            border: 1px solid var(--card-border);
            border-radius: 8px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
        }

            .dropdown-menu-cyber .dropdown-item {
                color: #cce3de;
                font-size: 0.95rem;
                padding: 10px 18px;
                transition: 0.2s;
            }

                .dropdown-menu-cyber .dropdown-item:hover {
                    background-color: #142826;
                    color: var(--neon-cyan);
                }

        /* Nút Giỏ Hàng */
        .btn-cyber-cart {
            border: 1px solid var(--neon-cyan);
            background: rgba(93, 242, 214, 0.1);
            color: var(--neon-cyan) !important;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            border-radius: 8px;
            transition: all 0.25s;
        }

            .btn-cyber-cart:hover {
                background: var(--neon-cyan);
                color: #000000 !important;
                box-shadow: 0 0 15px var(--neon-glow);
            }

        /* Footer */
        .footer-cyber {
            background: #040607;
            border-top: 1px solid #16332c;
            color: #cce3de;
            margin-top: auto;
        }

            .footer-cyber a {
                color: #b0c5c0;
                text-decoration: none;
            }

                .footer-cyber a:hover {
                    color: var(--neon-cyan);
                }
    </style>
</head>
<body>
    <div class="top-cyber-bar py-1 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-cpu text-info me-1"></i> DTBStore HARDWARE ECOSYSTEM</span>
                <span><i class="bi bi-shield-check text-success me-1"></i> BẢO HÀNH CHÍNH HÃNG 100%</span>
            </div>
            <div>
                <span class="me-3"><i class="bi bi-telephone-fill text-danger me-1"></i> HOTLINE: 1800 6868</span>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-cyber sticky-top py-3">
        <div class="container">
            <a class="navbar-brand navbar-brand-cyber d-flex align-items-center" asp-controller="Product" asp-action="Index">
                <i class="bi bi-gpu-card fs-3 me-2"></i>
                <span>DTB<span class="text-white">STORE</span></span>
            </a>

            <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <form class="d-flex mx-auto my-2 my-lg-0 w-50 search-cyber" method="get" asp-controller="Product" asp-action="Index">
                    <input class="form-control" type="search" name="search" value="@ViewBag.CurrentSearch"
                           placeholder="Tìm máy tính, RTX, Core i7, RAM 16GB..." />
                    <button class="btn" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    <!-- KHU VỰC TÀI KHOẢN KHÁCH HÀNG -->
                    @if (currentCustomer != null)
                    {
                        <!-- Khi đã đăng nhập: Hiển thị Dropdown tên khách hàng -->
                        <div class="dropdown">
                            <button class="btn btn-cyber-user px-3 py-2 dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-check-fill text-success fs-5 me-2"></i>
                                <span>@(currentCustomer.FullName.Length > 15 ? currentCustomer.FullName.Substring(0, 15) + "..." : currentCustomer.FullName)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-cyber dropdown-menu-end mt-2">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2 text-info"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" style="border-color: #1e453e;"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center text-danger" asp-controller="Account" asp-action="Logout" onclick="return confirm('Bạn có chắc muốn đăng xuất?');">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập: Nút Đăng nhập -->
                        <a asp-controller="Account" asp-action="Login" class="btn btn-cyber-user px-3 py-2 d-flex align-items-center">
                            <i class="bi bi-person-circle fs-5 me-2"></i>
                            <span>ĐĂNG NHẬP</span>
                        </a>
                    }

                    <!-- NÚT GIỎ HÀNG -->
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-cyber-cart px-3 py-2 d-flex align-items-center">
                        <i class="bi bi-cart3 fs-5 me-2"></i>
                        <span>GIỎ HÀNG</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer-cyber pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="navbar-brand-cyber mb-3"><i class="bi bi-gpu-card me-2"></i> DTBStore SYSTEM</h5>
                    <p class="small text-light opacity-75">Hệ thống phân phối Laptop Gaming, PC Modding và linh kiện phần cứng công nghệ cao.</p>
                    <p class="small mb-1 text-light"><i class="bi bi-geo-alt me-2 text-info"></i> 273 An Dương Vương, Phường 3, Quận 5, TP.HCM</p>
                </div>
                <div class="col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3 text-uppercase">Dịch Vụ</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#">Bảo hành tận nơi</a></li>
                        <li class="mb-2"><a href="#">Đổi mới 30 ngày</a></li>
                        <li class="mb-2"><a href="#">Tư vấn cấu hình máy</a></li>
                    </ul>
                </div>
                <div class="col-md-4 col-6">
                    <h6 class="text-white fw-bold mb-3 text-uppercase">Thanh Toán An Toàn</h6>
                    <p class="small text-light opacity-75">Hỗ trợ COD tận nơi, chuyển khoản QR Banking và trả góp 0% lãi suất.</p>
                </div>
            </div>
            <hr style="border-color: #1a3c35;" class="my-4" />
            <div class="text-center small text-light opacity-50">
                © 2026 DTBStore COMPUTER SYSTEM. TOÀN BỘ BẢN QUYỀN ĐƯỢC BẢO LƯU.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model IEnumerable<ComputerStore.Web.Models.CartItem>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Thanh toán đơn hàng - BMDTStore";

    // Tự động đọc dữ liệu khách hàng từ Session để điền sẵn
    var userJson = HttpContextAccessor.HttpContext?.Session.GetString(ComputerStore.Web.Controllers.AccountController.UserSessionKey);
    var customer = !string.IsNullOrEmpty(userJson)
        ? System.Text.Json.JsonSerializer.Deserialize<ComputerStore.Web.Models.ProfileViewModel>(userJson)
        : null;

    Func<object, string, object?> getProp = (obj, propName) =>
    {
        if (obj == null) return null;
        var p = obj.GetType().GetProperty(propName);
        if (p != null) return p.GetValue(obj);

        var productProp = obj.GetType().GetProperty("Product");
        if (productProp != null)
        {
            var productObj = productProp.GetValue(obj);
            if (productObj != null)
            {
                return productObj.GetType().GetProperty(propName)?.GetValue(productObj);
            }
        }
        return null;
    };

    decimal total = 0;
    if (Model != null)
    {
        foreach (var x in Model)
        {
            var pVal = getProp(x, "Price") ?? getProp(x, "UnitPrice");
            var qVal = getProp(x, "Quantity");
            decimal price = pVal != null ? Convert.ToDecimal(pVal) : 0m;
            int qty = qVal != null ? Convert.ToInt32(qVal) : 1;
            total += (price * qty);
        }
    }
}

<style>
    /* NẠP FONT CHỮ HIỆN ĐẠI (PLUS JAKARTA SANS & INTER) */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    :root {
        --checkout-font: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --neon-teal: #5df2d6;
        --dark-card: #0e1516;
        --dark-border: #1e453e;
        --dark-input: #142224;
    }

    body {
        background-color: #080c0d !important;
        color: #ffffff;
        font-family: var(--checkout-font);
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
    }

    /* NÚT QUAY LẠI TRÒN CÓ MŨI TÊN QUAY NGƯỢC BÊN TRÁI */
    .btn-back-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(93, 242, 214, 0.08);
        border: 1.5px solid #5df2d6;
        color: #5df2d6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 19px;
        transition: all 0.25s ease;
        box-shadow: 0 0 10px rgba(93, 242, 214, 0.15);
        flex-shrink: 0;
    }

        .btn-back-circle:hover {
            background: #5df2d6;
            color: #080c0d;
            box-shadow: 0 0 16px rgba(93, 242, 214, 0.4);
            transform: scale(1.08);
        }

    .checkout-card {
        background-color: var(--dark-card);
        border: 1.5px solid var(--dark-border);
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .checkout-title {
        color: var(--neon-teal);
        font-weight: 800;
        font-size: 26px;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
    }

    /* NHÃN VÀ Ô NHẬP LIỆU NỔI BẬT */
    .field-label {
        color: var(--neon-teal);
        font-size: 13.5px;
        font-weight: 700;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-control-cyber {
        font-family: var(--checkout-font) !important;
        background-color: var(--dark-input) !important;
        border: 1.5px solid #204841 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        font-size: 0.98rem !important;
        border-radius: 8px !important;
        padding: 12px 16px !important;
        width: 100%;
        margin-bottom: 6px;
        outline: none;
        transition: all 0.25s ease-in-out;
    }

        .form-control-cyber::placeholder {
            color: #8da4a4 !important;
            font-weight: 400 !important;
            opacity: 0.85;
        }

        .form-control-cyber:focus {
            background-color: #1a2c2f !important;
            border-color: var(--neon-teal) !important;
            box-shadow: 0 0 12px rgba(93, 242, 214, 0.4) !important;
            color: #ffffff !important;
        }

    .field-hint {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 16px;
        display: block;
    }

    /* PHƯƠNG THỨC THANH TOÁN */
    .payment-option-card {
        background: #111a1b;
        border: 1.5px solid var(--dark-border);
        border-radius: 10px;
        padding: 14px 16px;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .payment-option-card:hover {
            border-color: rgba(93, 242, 214, 0.5);
            background: #142526;
        }

    .payment-radio:checked + .payment-option-card {
        border-color: var(--neon-teal);
        background: rgba(93, 242, 214, 0.08);
        box-shadow: 0 0 14px rgba(93, 242, 214, 0.25);
    }

    .payment-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: rgba(93, 242, 214, 0.12);
        color: var(--neon-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    /* KHỐI LƯU Ý GIAO HÀNG */
    .delivery-notice-box {
        background: #121c1e;
        border-left: 4px solid var(--neon-teal);
        border-radius: 8px;
        padding: 18px 20px;
        margin-top: 18px;
        font-size: 14.5px;
        color: #f1f5f9;
        line-height: 1.7;
    }

        .delivery-notice-box strong.title-region {
            color: #ffffff;
            font-weight: 700;
            font-size: 15px;
            display: block;
            margin-bottom: 4px;
        }

        .delivery-notice-box ul {
            margin-bottom: 10px;
            padding-left: 22px;
        }

        .delivery-notice-box li {
            color: #e2e8f0;
            margin-bottom: 4px;
        }

    .delivery-notice-footer {
        color: #fde047;
        font-size: 13.5px;
        font-weight: 500;
        margin-top: 6px;
        padding-top: 8px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    /* NÚT HOÀN TẤT ĐẶT HÀNG */
    .btn-submit-order {
        background: linear-gradient(135deg, #00796b, #004d40);
        border: 1.5px solid var(--neon-teal);
        color: #ffffff;
        font-weight: 700;
        cursor: pointer;
        border-radius: 8px;
        font-size: 16px;
        padding: 14px 20px;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-submit-order:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 16px rgba(93, 242, 214, 0.6);
            transform: translateY(-2px);
        }

    @@media (max-width: 768px) {
        .checkout-card

    {
        padding: 18px;
        border-radius: 12px;
    }

    .checkout-title {
        font-size: 20px;
        margin-bottom: 18px;
    }

    .form-control-cyber {
        font-size: 16px !important;
        padding: 12px 14px !important;
    }

    .delivery-notice-box {
        padding: 14px 16px;
        font-size: 13.5px;
    }

    .btn-submit-order {
        padding: 14px;
        font-size: 15px;
    }

    }
</style>

<div class="container py-4">
    <!-- NÚT QUAY LẠI HÌNH TRÒN BÊN TRÁI -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/Cart" class="btn-back-circle" title="Quay lại giỏ hàng">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="checkout-title m-0">
            XÁC NHẬN THANH TOÁN &amp; ĐẶT HÀNG
        </h2>
    </div>

    <form asp-controller="Cart" asp-action="Checkout" method="post">
        <div class="row g-4">
            <!-- CỘT THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN -->
            <div class="col-lg-7">
                <div class="checkout-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <h4 style="color: #5df2d6; font-weight: 700; margin: 0; font-size: 18px;">
                            <i class="bi bi-geo-alt-fill me-1"></i> Thông tin nhận hàng
                        </h4>
                        @if (customer != null)
                        {
                            <span style="font-size: 12px; color: #34d399; border: 1px solid #34d399; background: rgba(52, 211, 153, 0.08); padding: 4px 10px; border-radius: 6px; font-weight: 700;">
                                <i class="bi bi-shield-check me-1"></i> Đã nạp từ tài khoản: @customer.FullName
                            </span>
                        }
                        else
                        {
                            <a href="/Account/Login?returnUrl=/Cart/Checkout" style="font-size: 13px; color: #5df2d6; text-decoration: none; font-weight: 700;">
                                <i class="bi bi-key-fill me-1"></i> Đăng nhập để tự điền
                            </a>
                        }
                    </div>

                    <!-- Ô HỌ VÀ TÊN -->
                    <label class="field-label">
                        <i class="bi bi-person-fill"></i> Họ và tên người nhận hàng:
                    </label>
                    <input type="text" name="customerName" class="form-control-cyber"
                           value="@(customer?.FullName ?? "")"
                           placeholder="Ví dụ: Nguyễn Văn A..." required />
                    <small class="field-hint">Họ tên sẽ được in trực tiếp lên phiếu xuất kho và bảo hành.</small>

                    <!-- Ô SỐ ĐIỆN THOẠI -->
                    <label class="field-label">
                        <i class="bi bi-telephone-fill"></i> Số điện thoại liên hệ nhận hàng:
                    </label>
                    <input type="tel" name="customerPhone" class="form-control-cyber"
                           value="@(customer?.PhoneNumber ?? "")"
                           placeholder="Ví dụ: 0912 345 678..." required />
                    <small class="field-hint">Shipper sẽ gọi xác nhận trước khi giao hàng tận nơi.</small>

                    <!-- Ô ĐỊA CHỈ -->
                    <label class="field-label">
                        <i class="bi bi-house-door-fill"></i> Địa chỉ giao hàng chi tiết:
                    </label>
                    <textarea name="shippingAddress" class="form-control-cyber" rows="3"
                              placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." required>@(customer?.Address ?? "")</textarea>
                    <small class="field-hint">Ghi rõ số nhà, tòa chung cư, số phòng để việc giao máy được chuẩn xác.</small>

                    <!-- CỤM PHƯƠNG THỨC THANH TOÁN -->
                    <label class="field-label mt-2">
                        <i class="bi bi-credit-card-2-front-fill"></i> Phương thức thanh toán:
                    </label>
                    <div class="d-flex flex-column gap-2 mb-3">
                        <!-- Option 1: COD -->
                        <label class="position-relative m-0">
                            <input type="radio" name="paymentMethod" value="COD" class="payment-radio d-none" checked />
                            <div class="payment-option-card">
                                <div class="payment-icon">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div style="font-weight: 700; color: #ffffff; font-size: 14.5px;">Thanh toán khi nhận hàng (COD)</div>
                                    <div style="font-size: 12.5px; color: #94a3b8;">Được đồng kiểm, cắm điện test màn hình và máy trước khi thanh toán.</div>
                                </div>
                                <i class="bi bi-check2-circle fs-4" style="color: var(--neon-teal);"></i>
                            </div>
                        </label>

                        <!-- Option 2: VietQR -->
                        <label class="position-relative m-0">
                            <input type="radio" name="paymentMethod" value="BANKING" class="payment-radio d-none" />
                            <div class="payment-option-card">
                                <div class="payment-icon">
                                    <i class="bi bi-qr-code-scan"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div style="font-weight: 700; color: #ffffff; font-size: 14.5px;">Chuyển khoản Ngân hàng (Quét mã VietQR 24/7)</div>
                                    <div style="font-size: 12.5px; color: #94a3b8;">Tự động xác nhận đơn hàng qua Internet Banking, miễn phí giao dịch.</div>
                                </div>
                                <i class="bi bi-check2-circle fs-4" style="color: var(--neon-teal);"></i>
                            </div>
                        </label>

                        <!-- Option 3: Thẻ ATM / VNPAY -->
                        <label class="position-relative m-0">
                            <input type="radio" name="paymentMethod" value="VNPAY" class="payment-radio d-none" />
                            <div class="payment-option-card">
                                <div class="payment-icon">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div style="font-weight: 700; color: #ffffff; font-size: 14.5px;">Cổng thanh toán điện tử (Thẻ ATM / Visa / VNPAY)</div>
                                    <div style="font-size: 12.5px; color: #94a3b8;">Hỗ trợ trả góp 0% thẻ tín dụng và thanh toán qua ví VNPAY.</div>
                                </div>
                                <i class="bi bi-check2-circle fs-4" style="color: var(--neon-teal);"></i>
                            </div>
                        </label>
                    </div>

                    <!-- KHUNG LƯU Ý GIAO HÀNG -->
                    <div class="delivery-notice-box">
                        <strong class="title-region">
                            <i class="bi bi-geo-alt-fill me-1" style="color: var(--neon-teal);"></i> Tại Miền Nam &amp; TP.HCM:
                        </strong>
                        <ul>
                            <li><strong>Laptop Gaming &amp; Văn phòng:</strong> Giao hỏa tốc trong 2 giờ sau khi đặt hàng (8h00 – 16h00).</li>
                            <li><strong>PC Gaming &amp; Workstation:</strong> Kỹ thuật viên giao tận nơi, hỗ trợ lắp ráp, cắm nguồn và test màn hình miễn phí (8h00 – 17h00).</li>
                        </ul>
                        <strong class="title-region">
                            <i class="bi bi-truck me-1" style="color: var(--neon-teal);"></i> Tại Miền Bắc &amp; Các tỉnh khác:
                        </strong>
                        <ul>
                            <li>Giao hàng từ 8h00 – 16h00 qua đơn vị chuyển phát có bảo hiểm 100%, đóng thùng xốp chống sốc nguyên khối bảo vệ card đồ họa và linh kiện.</li>
                        </ul>
                        <div class="delivery-notice-footer">
                            <i class="bi bi-clock-history me-1"></i> <strong>Lưu ý:</strong> Khách đặt hàng từ 8h00 – 16h00: tiến hành kiểm tra phần cứng (burn-in test) và giao trong ngày. Khách đặt hàng sau 16h00: giao hàng ngày hôm sau.
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT TÓM TẮT ĐƠN HÀNG -->
            <div class="col-lg-5">
                <div class="checkout-card">
                    <h4 style="color: #5df2d6; font-weight: 700; margin-bottom: 20px; font-size: 18px;">
                        <i class="bi bi-receipt me-1"></i> Tóm tắt đơn hàng
                    </h4>

                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            var name = getProp(item, "ProductName")?.ToString()
                            ?? getProp(item, "Name")?.ToString()
                            ?? "Laptop Gaming";

                            var priceObj = getProp(item, "Price") ?? getProp(item, "UnitPrice");
                            var price = priceObj != null ? Convert.ToDecimal(priceObj) : 0m;

                            var qtyObj = getProp(item, "Quantity");
                            var qty = qtyObj != null ? Convert.ToInt32(qtyObj) : 1;

                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom: 1px solid #142826;">
                                <div style="max-width: 68%;">
                                    <div style="font-weight: 600; color: #fff; font-size: 14.5px; line-height: 1.4;">@name</div>
                                    <small style="color: #8da4a4; font-size: 13px;">Số lượng: <strong style="color: #5df2d6;">@qty</strong></small>
                                </div>
                                <div style="color: #5df2d6; font-weight: 700; font-size: 15px; white-space: nowrap;">@string.Format("{0:N0} đ", price * qty)</div>
                            </div>
                        }
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 mb-4" style="border-top: 1px solid #1e453e;">
                        <div style="font-size: 15px; color: #8da4a4; font-weight: 600;">Tổng thanh toán:</div>
                        <div style="font-size: 22px; font-weight: 800; color: #facc15; white-space: nowrap;">@string.Format("{0:N0} đ", total)</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-submit-order">
                            <i class="bi bi-check-circle-fill"></i> HOÀN TẤT ĐẶT HÀNG
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
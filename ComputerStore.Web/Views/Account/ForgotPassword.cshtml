@model ComputerStore.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - DTBStore";
}

<style>
    body {
        background-color: #080c0d !important;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .auth-card {
        background-color: #0e1516;
        border: 1px solid #1e453e;
        border-radius: 12px;
        padding: 35px;
        max-width: 440px;
        margin: 40px auto;
        box-shadow: 0 0 30px rgba(93, 242, 214, 0.12);
    }

    .form-control-cyber {
        background-color: #141f21;
        border: 1px solid #1e453e;
        color: #ffffff;
        border-radius: 6px;
        padding: 12px 14px;
        width: 100%;
        margin-bottom: 15px;
        outline: none;
    }

        .form-control-cyber:focus {
            border-color: #5df2d6;
            box-shadow: 0 0 10px rgba(93, 242, 214, 0.4);
        }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

        .password-wrapper input {
            margin-bottom: 0 !important;
            padding-right: 48px;
        }

    .btn-toggle-eye {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        color: #5df2d6 !important;
        cursor: pointer;
        font-size: 1.3rem;
        text-shadow: 0 0 10px #5df2d6;
    }

    .btn-auth {
        background: linear-gradient(135deg, #00796b, #004d40);
        border: 1px solid #5df2d6;
        color: #fff;
        font-weight: 700;
        padding: 12px 0;
        width: 100%;
        border-radius: 6px;
        cursor: pointer;
        margin-top: 10px;
    }

        .btn-auth:hover {
            background: #5df2d6;
            color: #080c0d;
            box-shadow: 0 0 14px rgba(93, 242, 214, 0.5);
        }
</style>

<div class="container py-4">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h2 style="color: #5df2d6; font-weight: 800;">⚡ ĐẶT LẠI MẬT KHẨU</h2>
            <p style="color: #8da4a4; font-size: 13.5px;">Nhập tài khoản để thiết lập mật khẩu mới</p>
        </div>

        <form action="/Account/ForgotPassword" method="post">
            <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Số điện thoại hoặc Email đã đăng ký</label>
            <input asp-for="Username" class="form-control-cyber" placeholder="0385550832 hoặc email@domain.com" required />

            <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Mật khẩu mới</label>
            <div class="password-wrapper">
                <input asp-for="NewPassword" type="password" id="pass1" class="form-control-cyber" placeholder="Tối thiểu 6 ký tự" required />
                <button type="button" class="btn-toggle-eye" onclick="toggleField('pass1', 'icon1')">
                    <i id="icon1" class="bi bi-eye-fill"></i>
                </button>
            </div>

            <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Xác nhận lại mật khẩu mới</label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" type="password" id="pass2" class="form-control-cyber" placeholder="Nhập lại mật khẩu mới" required />
                <button type="button" class="btn-toggle-eye" onclick="toggleField('pass2', 'icon2')">
                    <i id="icon2" class="bi bi-eye-fill"></i>
                </button>
            </div>

            <button type="submit" class="btn-auth">LƯU MẬT KHẨU MỚI</button>
        </form>

        <div class="text-center mt-4" style="font-size: 13.5px; border-top: 1px solid #142826; padding-top: 15px;">
            <a href="/Account/Login" style="color: #5df2d6; text-decoration: none; font-weight: 600;">← Quay lại Đăng nhập</a>
        </div>
    </div>
</div>

<script>
    function toggleField(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (input.type === "password") {
            input.type = "text";
            icon.className = "bi bi-eye-slash-fill";
        } else {
            input.type = "password";
            icon.className = "bi bi-eye-fill";
        }
    }
</script>
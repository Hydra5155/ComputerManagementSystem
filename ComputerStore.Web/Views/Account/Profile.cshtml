@model ComputerStore.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân - DTBStore";
}

<style>
    body {
        background-color: #080c0d !important;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .profile-card {
        background-color: #0e1516;
        border: 1px solid #1e453e;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 0 25px rgba(93, 242, 214, 0.1);
    }

    .form-control-cyber {
        background-color: #141f21;
        border: 1px solid #1e453e;
        color: #ffffff;
        border-radius: 6px;
        padding: 10px 14px;
        width: 100%;
        margin-bottom: 15px;
        outline: none;
    }

        .form-control-cyber:focus {
            border-color: #5df2d6;
            box-shadow: 0 0 8px rgba(93, 242, 214, 0.4);
        }

    .btn-update {
        background: linear-gradient(135deg, #00796b, #004d40);
        border: 1px solid #5df2d6;
        color: #fff;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-update:hover {
            background: #5df2d6;
            color: #080c0d;
        }

    .btn-logout {
        border: 1px solid #f87171;
        color: #f87171;
        background: transparent;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-logout:hover {
            background: rgba(248, 113, 113, 0.2);
            color: #ff9999;
        }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #5df2d6; font-weight: 800; margin: 0;">⚡ THÔNG TIN KHÁCH HÀNG</h2>
            <small style="color: #8da4a4;">Quản lý hồ sơ cá nhân và địa chỉ giao hàng của bạn</small>
        </div>
        <div class="d-flex gap-2">
            <a href="/Product" style="border: 1px solid #1e453e; color: #5df2d6; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 13.5px; display: inline-flex; align-items: center;">Tiếp tục mua hàng</a>
            <a href="/Account/Logout" class="btn-logout" onclick="return confirm('Bạn có chắc muốn đăng xuất?');">Đăng xuất ➔</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 mb-4" style="background: rgba(52, 211, 153, 0.2); border-color: #34d399; color: #34d399;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <!-- Thông tin tóm tắt -->
        <div class="col-lg-4 mb-4">
            <div class="profile-card text-center">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: #142826; border: 2px solid #5df2d6; display: flex; align-items: center; justify-content: center; font-size: 32px; margin: 0 auto 15px auto;">
                    👤
                </div>
                <h4 style="color: #ffffff; font-weight: 700; margin-bottom: 5px;">@Model?.FullName</h4>
                <div style="color: #5df2d6; font-size: 13px; font-weight: 600; margin-bottom: 15px;">Thành viên DTBStore VIP</div>
                <hr style="border-color: #1e453e;" />
                <div class="text-start" style="font-size: 13.5px; color: #8da4a4; line-height: 2;">
                    <div>📱 SĐT: <b style="color: #fff;">@Model?.PhoneNumber</b></div>
                    <div>✉️ Email: <b style="color: #fff;">@(string.IsNullOrEmpty(Model?.Email) ? "Chưa cập nhật" : Model.Email)</b></div>
                    <div>📍 Khu vực: <b style="color: #fff;">@(string.IsNullOrEmpty(Model?.Address) ? "Chưa cập nhật" : Model.Address)</b></div>
                </div>
            </div>
        </div>

        <!-- Form chỉnh sửa thông tin -->
        <div class="col-lg-8">
            <div class="profile-card">
                <h5 style="color: #5df2d6; font-weight: 700; margin-bottom: 20px;">Cập nhật thông tin nhận hàng</h5>
                <form asp-action="Profile" method="post">
                    <input type="hidden" asp-for="CustomerId" />

                    <div class="row">
                        <div class="col-md-6">
                            <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Họ và tên</label>
                            <input asp-for="FullName" class="form-control-cyber" required />
                        </div>
                        <div class="col-md-6">
                            <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control-cyber" required />
                        </div>
                    </div>

                    <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Địa chỉ Email</label>
                    <input asp-for="Email" class="form-control-cyber" />

                    <label style="color: #8da4a4; font-size: 13px; margin-bottom: 4px;">Địa chỉ nhận hàng (Mặc định khi thanh toán)</label>
                    <textarea asp-for="Address" class="form-control-cyber" rows="3" required></textarea>

                    <button type="submit" class="btn-update">LƯU THAY ĐỔI</button>
                </form>
            </div>
        </div>
    </div>
</div>
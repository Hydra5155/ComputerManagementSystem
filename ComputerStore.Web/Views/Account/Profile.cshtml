@model ComputerStore.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân - BMDTStore";
}

<style>
    :root {
        --bg-dark: #080c0d;
        --card-dark: #0e1516;
        --card-inner: #141f21;
        --card-border: #1e453e;
        --neon-cyan: #5df2d6;
        --neon-glow: rgba(93, 242, 214, 0.25);
        --text-sub: #8da4a4;
    }

    body {
        background-color: var(--bg-dark) !important;
        color: #ffffff;
        font-family: 'Rajdhani', 'Segoe UI', sans-serif;
    }

    /* NÚT QUAY LẠI TRÒN CÓ MŨI TÊN QUAY NGƯỢC BÊN TRÁI */
    .btn-back-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(93, 242, 214, 0.08);
        border: 1.5px solid var(--neon-cyan);
        color: var(--neon-cyan);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 19px;
        transition: all 0.25s ease;
        box-shadow: 0 0 10px rgba(93, 242, 214, 0.15);
        flex-shrink: 0;
    }

        .btn-back-circle:hover {
            background: var(--neon-cyan);
            color: #080c0d;
            box-shadow: 0 0 16px var(--neon-glow);
            transform: scale(1.08);
        }

    .profile-card {
        background-color: var(--card-dark);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        padding: 32px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
        transition: border-color 0.25s ease;
    }

        .profile-card:hover {
            border-color: rgba(93, 242, 214, 0.4);
        }

    .form-control-cyber {
        background-color: var(--card-inner) !important;
        border: 1.5px solid var(--card-border) !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 12px 16px;
        width: 100%;
        margin-bottom: 18px;
        outline: none;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .form-control-cyber:focus {
            border-color: var(--neon-cyan) !important;
            box-shadow: 0 0 12px var(--neon-glow) !important;
            background-color: #162628 !important;
        }

    .form-label-cyber {
        color: var(--text-sub);
        font-size: 0.88rem;
        font-weight: 700;
        margin-bottom: 6px;
        display: block;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .btn-update {
        background: linear-gradient(135deg, #00796b, #004d40);
        border: 1.5px solid var(--neon-cyan);
        color: #fff;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.98rem;
        letter-spacing: 0.5px;
    }

        .btn-update:hover {
            background: var(--neon-cyan);
            color: #080c0d;
            box-shadow: 0 0 16px var(--neon-glow);
            transform: translateY(-2px);
        }

    .btn-logout {
        border: 1px solid #f87171;
        color: #f87171;
        background: transparent;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 700;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-logout:hover {
            background: rgba(248, 113, 113, 0.2);
            color: #ff9999;
        }
</style>

<div class="container py-4" style="max-width: 1050px;">
    <!-- TIÊU ĐỀ & NÚT TRÒN QUAY LẠI BÊN TRÁI -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <a href="/Product" class="btn-back-circle" title="Tiếp tục mua sắm">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 style="color: var(--neon-cyan); font-weight: 800; margin: 0; letter-spacing: -0.02em; font-size: 1.7rem;">
                    <i class="bi bi-person-gear me-2"></i>THÔNG TIN CÁ NHÂN
                </h2>
                <small style="color: var(--text-sub); font-size: 0.95rem;">Quản lý hồ sơ tài khoản và địa chỉ giao nhận mặc định tại BMDTStore</small>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="/Account/Orders" style="border: 1px solid var(--card-border); color: var(--neon-cyan); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <i class="bi bi-box-seam"></i> Xem đơn hàng
            </a>
            <a href="/Account/Logout" class="btn-logout" onclick="return confirm('Bạn có chắc muốn đăng xuất tài khoản?');">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 mb-4 d-flex align-items-center gap-2" style="background: rgba(16, 185, 129, 0.15); border-color: #10b981; color: #6ee7b7; border-radius: 10px;">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- 1. THẺ THÔNG TIN TÓM TẮT TÀI KHOẢN -->
        <div class="col-lg-4">
            <div class="profile-card text-center h-100 d-flex flex-column justify-content-center align-items-center py-5">
                <div style="width: 90px; height: 90px; border-radius: 50%; background: #142826; border: 2px solid var(--neon-cyan); display: flex; align-items: center; justify-content: center; font-size: 38px; margin-bottom: 18px; box-shadow: 0 0 18px var(--neon-glow);">
                    👤
                </div>
                <h4 style="color: #ffffff; font-weight: 700; margin-bottom: 6px; font-size: 1.3rem;">@Model?.FullName</h4>
                <div style="color: var(--neon-cyan); font-size: 12.5px; font-weight: 700; margin-bottom: 20px; letter-spacing: 0.5px;">
                    <i class="bi bi-shield-fill-check me-1"></i> KHÁCH HÀNG THÂN THIẾT
                </div>
                <hr style="border-color: var(--card-border); width: 100%; margin: 10px 0 20px 0;" />
                <div class="text-start w-100 px-2" style="font-size: 0.92rem; color: var(--text-sub); line-height: 2.2;">
                    <div>📱 SĐT: <b style="color: #ffffff;">@Model?.PhoneNumber</b></div>
                    <div>✉️ Email: <b style="color: #ffffff;">@(string.IsNullOrEmpty(Model?.Email) ? "Chưa cập nhật" : Model.Email)</b></div>
                    <div>📍 Khu vực: <b style="color: #ffffff;">@(string.IsNullOrEmpty(Model?.Address) ? "Chưa cập nhật" : Model.Address)</b></div>
                </div>
            </div>
        </div>

        <!-- 2. FORM CẬP NHẬT THÔNG TIN CÁ NHÂN -->
        <div class="col-lg-8">
            <div class="profile-card h-100">
                <h5 style="color: var(--neon-cyan); font-weight: 700; margin-bottom: 22px; font-size: 1.15rem;">
                    <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ tài khoản
                </h5>
                <form asp-action="Profile" method="post">
                    <input type="hidden" asp-for="CustomerId" />

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label-cyber">Họ và tên</label>
                            <input asp-for="FullName" class="form-control-cyber" placeholder="Nhập họ và tên..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-cyber">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control-cyber" placeholder="Nhập số điện thoại..." required />
                        </div>
                    </div>

                    <label class="form-label-cyber">Địa chỉ Email</label>
                    <input asp-for="Email" class="form-control-cyber" placeholder="Nhập email..." />

                    <label class="form-label-cyber">Địa chỉ nhận hàng mặc định</label>
                    <textarea asp-for="Address" class="form-control-cyber" rows="3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." required></textarea>

                    <div class="mt-3">
                        <button type="submit" class="btn-update">
                            <i class="bi bi-save2-fill"></i> LƯU THAY ĐỔI
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model ComputerStore.Core.Entities.Product
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = (Model?.Name ?? "Chi tiết sản phẩm") + " - BMDTStore";

    // 1. Kiểm tra trạng thái đăng nhập của khách hàng
    var userJson = HttpContextAccessor.HttpContext?.Session.GetString(ComputerStore.Web.Controllers.AccountController.UserSessionKey);
    bool isLoggedIn = !string.IsNullOrEmpty(userJson);

    // 2. Quét trường cấu hình an toàn
    var itemType = Model?.GetType();
    var specProp = itemType?.GetProperty("Description")
                ?? itemType?.GetProperty("Specifications")
                ?? itemType?.GetProperty("Specs")
                ?? itemType?.GetProperty("Detail");
    var specs = specProp != null ? (specProp.GetValue(Model)?.ToString() ?? "") : "";

    // 3. Quét ảnh
    var imgProp = itemType?.GetProperty("ImageUrl")
               ?? itemType?.GetProperty("Image")
               ?? itemType?.GetProperty("Thumbnail")
               ?? itemType?.GetProperty("Picture")
               ?? itemType?.GetProperty("Photo");
    var rawImg = imgProp != null ? (imgProp.GetValue(Model)?.ToString() ?? "") : "";

    string finalImg = "";
    if (string.IsNullOrWhiteSpace(rawImg))
    {
        finalImg = "https://images.unsplash.com/photo-1603302576837-37561b2e2302?w=600&q=80";
    }
    else if (rawImg.StartsWith("http://") || rawImg.StartsWith("https://") || rawImg.StartsWith("/"))
    {
        finalImg = rawImg;
    }
    else
    {
        finalImg = "/" + rawImg;
    }

    var idVal = Model?.ProductId ?? 0;
    var nameVal = Model?.Name ?? "Thiết bị công nghệ";
    var priceVal = Model?.Price ?? 0m;
    var stockVal = Model?.StockQuantity ?? 0;
    var categoryName = Model?.Category?.Name ?? "Máy tính & Laptop";
}

<style>
    /* NẠP FONT CHỮ HIỆN ĐẠI (INTER & PLUS JAKARTA SANS) */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    :root {
        --detail-font: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
        --neon-teal: #5df2d6;
        --dark-card: #0e1516;
        --dark-border: #1e453e;
        --dark-input: #152224;
    }

    body {
        background-color: #080c0d !important;
        color: #f1f5f9;
        font-family: var(--detail-font);
        letter-spacing: -0.01em;
    }

    .detail-card {
        background: var(--dark-card);
        border: 1.5px solid var(--dark-border);
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 35px rgba(93, 242, 214, 0.08);
        transition: border-color 0.3s ease;
    }

        .detail-card:hover {
            border-color: rgba(93, 242, 214, 0.4);
        }

    .detail-img-box {
        background: radial-gradient(circle at center, #142224 0%, #080c0d 100%);
        border: 1px solid var(--dark-border);
        border-radius: 14px;
        padding: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
        position: relative;
        overflow: hidden;
    }

        .detail-img-box img {
            max-height: 330px;
            max-width: 100%;
            object-fit: contain;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .detail-img-box:hover img {
            transform: scale(1.06);
        }

    .badge-code {
        background: rgba(93, 242, 214, 0.1);
        border: 1px solid #206153;
        color: var(--neon-teal);
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .badge-category {
        background: #142022;
        border: 1px solid var(--dark-border);
        color: #94a3b8;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
    }

    .detail-title {
        color: #ffffff;
        font-weight: 800;
        font-size: 30px;
        margin: 18px 0 12px 0;
        line-height: 1.35;
        letter-spacing: -0.02em;
    }

    .detail-price {
        font-size: 34px;
        font-weight: 800;
        color: var(--neon-teal);
        margin-bottom: 22px;
        text-shadow: 0 0 18px rgba(93, 242, 214, 0.35);
    }

    .specs-box {
        background: #141f21;
        border: 1px solid var(--dark-border);
        border-radius: 10px;
        padding: 20px;
        font-size: 14.5px;
        line-height: 1.85;
        color: #e2e8f0;
        white-space: pre-line;
        margin-bottom: 26px;
    }

    /* KHỐI LƯU Ý GIAO HÀNG (THEO MẪU ẢNH) */
    .delivery-notice-box {
        background: #121c1e;
        border-left: 4px solid var(--neon-teal);
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 26px;
        font-size: 14.5px;
        color: #f1f5f9;
        line-height: 1.7;
    }

        .delivery-notice-box strong.title-region {
            color: #ffffff;
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
        }

        .delivery-notice-box ul {
            margin-bottom: 8px;
            padding-left: 20px;
        }

        .delivery-notice-box li {
            margin-bottom: 3px;
            color: #cbd5e1;
        }

    .delivery-notice-note {
        color: #fde047;
        font-size: 13.5px;
        font-weight: 500;
        margin-top: 6px;
    }

    /* Ô NHẬP LIỆU */
    .qty-input-detail {
        background-color: var(--dark-input);
        border: 1.5px solid var(--dark-border);
        color: #ffffff;
        border-radius: 8px;
        padding: 10px;
        width: 80px;
        text-align: center;
        font-weight: 700;
        font-size: 16px;
        outline: none;
        transition: all 0.25s;
    }

        .qty-input-detail:focus {
            border-color: var(--neon-teal);
            box-shadow: 0 0 12px rgba(93, 242, 214, 0.35);
        }

    .btn-buy-detail {
        background: linear-gradient(135deg, #00897b, #004d40);
        border: 1.5px solid var(--neon-teal);
        color: #ffffff;
        font-weight: 700;
        padding: 12px 34px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-buy-detail:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 22px rgba(93, 242, 214, 0.6);
            transform: translateY(-2px);
        }

    .btn-buy-disabled {
        background: #2b3a3c !important;
        border: 1px solid #4a5d60 !important;
        color: #7d8e91 !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
        transform: none !important;
    }

    .btn-login-to-buy {
        background: rgba(239, 68, 68, 0.15);
        border: 1.5px solid #f87171;
        color: #fca5a5;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s ease;
    }

        .btn-login-to-buy:hover {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 0 18px rgba(239, 68, 68, 0.6);
            transform: translateY(-2px);
        }

    .btn-back {
        background: #142022;
        border: 1px solid var(--dark-border);
        color: #94a3b8;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }

        .btn-back:hover {
            color: var(--neon-teal);
            border-color: var(--neon-teal);
            background: #19282b;
        }

    /* TỐI ƯU CHO MOBILE */
    @@media (max-width: 768px) {
        .detail-card {
            padding: 20px;
        }

        .detail-title {
            font-size: 22px;
        }

        .detail-price {
            font-size: 26px;
        }

        .detail-img-box {
            min-height: 280px;
            padding: 16px;
        }

            .detail-img-box img {
                max-height: 240px;
            }

        .delivery-notice-box {
            padding: 14px 16px;
            font-size: 13.5px;
        }

        .btn-buy-detail, .btn-login-to-buy, .btn-back {
            width: 100%;
            justify-content: center;
            padding: 14px 20px;
            font-size: 16px;
        }
    }
</style>

<div class="container py-4">
    <!-- NÚT QUAY LẠI -->
    <a href="/Product" style="color: #5df2d6; text-decoration: none; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: transform 0.2s;" onmouseover="this.style.transform='translateX(-3px)'" onmouseout="this.style.transform='none'">
        <i class="bi bi-arrow-left"></i> QUAY LẠI CỬA HÀNG BMDTSTORE
    </a>

    @if (Model != null)
    {
        <div class="detail-card">
            <div class="row align-items-center">
                <!-- CỘT HÌNH ẢNH SẢN PHẨM -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <div class="detail-img-box">
                        <img src="@finalImg"
                             alt="@nameVal"
                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603302576837-37561b2e2302?w=600&q=80';" />
                    </div>
                </div>

                <!-- CỘT THÔNG TIN CHI TIẾT -->
                <div class="col-lg-7 ps-lg-4">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge-code">MÃ MÁY: #@idVal</span>
                        <span class="badge-category"><i class="bi bi-laptop me-1"></i>@categoryName</span>
                        @if (stockVal > 0)
                        {
                            <span style="border: 1px solid #34d399; color: #34d399; font-size: 12px; padding: 6px 12px; border-radius: 6px; font-weight: 700; background: rgba(52, 211, 153, 0.08);">
                                <i class="bi bi-check2-circle me-1"></i> CÒN HÀNG (@stockVal máy sẵn sàng)
                            </span>
                        }
                        else
                        {
                            <span style="border: 1px solid #f87171; color: #f87171; font-size: 12px; padding: 6px 12px; border-radius: 6px; font-weight: 700; background: rgba(248, 113, 113, 0.08);">
                                <i class="bi bi-x-circle me-1"></i> TẠM HẾT HÀNG
                            </span>
                        }
                    </div>

                    <h1 class="detail-title">@nameVal</h1>

                    <div class="detail-price">
                        @string.Format("{0:N0} đ", priceVal)
                    </div>

                    <!-- THÔNG SỐ KỸ THUẬT -->
                    <div>
                        <div style="color: #5df2d6; font-weight: 700; font-size: 13.5px; margin-bottom: 8px; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-cpu-fill"></i> CẤU HÌNH & THÔNG SỐ KỸ THUẬT:
                        </div>
                        <div class="specs-box">
                            @(string.IsNullOrWhiteSpace(specs) ? "Đang cập nhật thông số kỹ thuật chi tiết cho cấu hình máy này..." : specs)
                        </div>
                    </div>

                    <!-- KHUNG THÔNG TIN GIAO HÀNG (THEO MẪU ẢNH) -->
                    <div class="delivery-notice-box">
                        <strong class="title-region">Tại Miền Nam:</strong>
                        <ul>
                            <li>8h00 – 14h00 đối với hàng điện máy</li>
                            <li>8h00 – 16h00 đối với hàng thực phẩm</li>
                        </ul>
                        <strong class="title-region">Tại Miền Bắc:</strong>
                        <ul>
                            <li>Từ 8h00 – 16h00</li>
                        </ul>
                        <div class="delivery-notice-note">
                            <strong>Lưu ý:</strong> Khách đặt hàng từ 8h00 – 16h00: giao hàng trong ngày. Khách đặt hàng sau 16h00: giao hàng ngày hôm sau.
                        </div>
                    </div>

                    <!-- KHU VỰC NÚT MUA HÀNG -->
                    @if (isLoggedIn)
                    {
                        if (stockVal > 0)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex align-items-center gap-3 flex-wrap">
                                <input type="hidden" name="productId" value="@idVal" />
                                <input type="hidden" name="returnUrl" value="/Product/Detail/@idVal" />

                                <div class="d-flex align-items-center gap-2">
                                    <span style="color: #cbd5e1; font-weight: 600; font-size: 14px;">Số lượng:</span>
                                    <input type="number" id="detailQuantity" name="quantity" class="qty-input-detail"
                                           value="1" min="1" max="@stockVal"
                                           oninput="if(parseInt(this.value) > @stockVal) this.value = @stockVal; if(parseInt(this.value) < 1) this.value = 1;" />
                                </div>

                                <button type="submit" class="btn-buy-detail">
                                    <i class="bi bi-cart3"></i> MUA NGAY
                                </button>

                                <a href="/Product" class="btn-back">
                                    Xem máy khác
                                </a>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <button type="button" class="btn-buy-detail btn-buy-disabled" disabled>
                                    <i class="bi bi-x-circle"></i> TẠM HẾT HÀNG
                                </button>

                                <a href="/Product" class="btn-back">
                                    Xem máy khác
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Khách CHƯA đăng nhập -->
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Product/Detail/@idVal" class="btn-login-to-buy">
                                <i class="bi bi-box-arrow-in-right"></i> ĐĂNG NHẬP ĐỂ MUA HÀNG
                            </a>

                            <a href="/Product" class="btn-back">
                                Xem máy khác
                            </a>
                        </div>
                        <div class="mt-2 small text-warning opacity-75">
                            <i class="bi bi-info-circle me-1"></i> Bạn cần đăng nhập tài khoản BMDTStore để tiếp tục đặt hàng.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
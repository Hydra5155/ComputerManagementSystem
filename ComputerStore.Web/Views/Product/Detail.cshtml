@model ComputerStore.Core.Entities.Product
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = (Model?.Name ?? "Chi tiết sản phẩm") + " - BMDTStore";

    // 1. Kiểm tra trạng thái đăng nhập của khách hàng
    var userJson = HttpContextAccessor.HttpContext?.Session.GetString(ComputerStore.Web.Controllers.AccountController.UserSessionKey);
    bool isLoggedIn = !string.IsNullOrEmpty(userJson);

    // 2. Quét trường cấu hình an toàn
    var itemType = Model?.GetType();
    var specProp = itemType?.GetProperty("Description")
                ?? itemType?.GetProperty("Specifications")
                ?? itemType?.GetProperty("Specs")
                ?? itemType?.GetProperty("Detail");
    var specs = specProp != null ? (specProp.GetValue(Model)?.ToString() ?? "") : "";

    // 3. Quét ảnh
    var imgProp = itemType?.GetProperty("ImageUrl")
               ?? itemType?.GetProperty("Image")
               ?? itemType?.GetProperty("Thumbnail")
               ?? itemType?.GetProperty("Picture")
               ?? itemType?.GetProperty("Photo");
    var rawImg = imgProp != null ? (imgProp.GetValue(Model)?.ToString() ?? "") : "";

    string finalImg = "";
    if (string.IsNullOrWhiteSpace(rawImg))
    {
        finalImg = "https://images.unsplash.com/photo-1603302576837-37561b2e2302?w=600&q=80";
    }
    else if (rawImg.StartsWith("http://") || rawImg.StartsWith("https://") || rawImg.StartsWith("/"))
    {
        finalImg = rawImg;
    }
    else
    {
        finalImg = "/" + rawImg;
    }

    var idVal = Model?.ProductId ?? 0;
    var nameVal = Model?.Name ?? "Thiết bị công nghệ";
    var priceVal = Model?.Price ?? 0m;
    var stockVal = Model?.StockQuantity ?? 0;
    var categoryName = Model?.Category?.Name ?? "Máy tính & Laptop";
}

<style>
    /* NẠP FONT CHỮ HIỆN ĐẠI */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    :root {
        --detail-font: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
        --neon-teal: #5df2d6;
        --dark-card: #0e1516;
        --dark-border: #1e453e;
        --dark-input: #152224;
    }

    body {
        background-color: #080c0d !important;
        color: #f1f5f9;
        font-family: var(--detail-font);
        letter-spacing: -0.01em;
    }

    /* NÚT QUAY LẠI TRÒN CÓ MŨI TÊN QUAY NGƯỢC BÊN TRÁI */
    .btn-back-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(93, 242, 214, 0.08);
        border: 1.5px solid var(--neon-teal);
        color: var(--neon-teal);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 19px;
        transition: all 0.25s ease;
        box-shadow: 0 0 10px rgba(93, 242, 214, 0.15);
        flex-shrink: 0;
    }

        .btn-back-circle:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 16px rgba(93, 242, 214, 0.4);
            transform: scale(1.08);
        }

    .detail-card {
        background: var(--dark-card);
        border: 1.5px solid var(--dark-border);
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 35px rgba(93, 242, 214, 0.08);
        transition: border-color 0.3s ease;
    }

        .detail-card:hover {
            border-color: rgba(93, 242, 214, 0.4);
        }

    /* KHUNG ẢNH CHÍNH CÓ NHÃN NỔI */
    .detail-img-box {
        background: radial-gradient(circle at center, #142224 0%, #080c0d 100%);
        border: 1px solid var(--dark-border);
        border-radius: 14px;
        padding: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
        position: relative;
        overflow: hidden;
    }

        .detail-img-box img {
            max-height: 330px;
            max-width: 100%;
            object-fit: contain;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 1;
        }

        .detail-img-box:hover img {
            transform: scale(1.06);
        }

    /* NHÃN GÓC PHẢI TRÊN KHUNG ẢNH */
    .detail-floating-stock {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 30 !important;
        font-size: 11.5px;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.95);
        pointer-events: none;
    }

    .stock-out {
        background: rgba(45, 10, 15, 0.95) !important;
        border: 1.5px solid #ff4d6d !important;
        color: #ff758f !important;
    }

    .stock-last-one {
        background: linear-gradient(135deg, #ff3b00 0%, #ff0055 100%) !important;
        border: 1.5px solid #ffe600 !important;
        color: #ffffff !important;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        box-shadow: 0 0 20px rgba(255, 59, 0, 0.9), 0 4px 14px rgba(0, 0, 0, 0.9) !important;
    }

    .stock-low {
        background: rgba(45, 35, 8, 0.95) !important;
        border: 1.5px solid #ffc300 !important;
        color: #ffd60a !important;
    }

    .stock-available {
        background: rgba(6, 40, 28, 0.95) !important;
        border: 1.5px solid #00f5d4 !important;
        color: #00f5d4 !important;
    }

    .badge-code {
        background: rgba(93, 242, 214, 0.1);
        border: 1px solid #206153;
        color: var(--neon-teal);
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .badge-category {
        background: #142022;
        border: 1px solid var(--dark-border);
        color: #94a3b8;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
    }

    .detail-title {
        color: #ffffff;
        font-weight: 800;
        font-size: 30px;
        margin: 18px 0 12px 0;
        line-height: 1.35;
        letter-spacing: -0.02em;
    }

    .detail-price {
        font-size: 34px;
        font-weight: 800;
        color: var(--neon-teal);
        margin-bottom: 22px;
        text-shadow: 0 0 18px rgba(93, 242, 214, 0.35);
    }

    .specs-box {
        background: #141f21;
        border: 1px solid var(--dark-border);
        border-radius: 10px;
        padding: 20px;
        font-size: 14.5px;
        line-height: 1.85;
        color: #e2e8f0;
        white-space: pre-line;
        margin-bottom: 26px;
    }

    .delivery-notice-box {
        background: #121c1e;
        border-left: 4px solid var(--neon-teal);
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 26px;
        font-size: 14.5px;
        color: #f1f5f9;
        line-height: 1.7;
    }

        .delivery-notice-box strong.title-region {
            color: #ffffff;
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
        }

        .delivery-notice-box ul {
            margin-bottom: 8px;
            padding-left: 20px;
        }

        .delivery-notice-box li {
            margin-bottom: 3px;
            color: #cbd5e1;
        }

    .delivery-notice-note {
        color: #fde047;
        font-size: 13.5px;
        font-weight: 500;
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    /* ĐỒNG BỘ CHIỀU CAO VÀ ĐƯỜNG NÉT CÁC NÚT BẤM (CHUNG 1 HÀNG 48PX) */
    .qty-cyber-group {
        display: inline-flex;
        align-items: center;
        background: #121f21;
        border: 1.5px solid var(--dark-border);
        border-radius: 10px;
        overflow: hidden;
        height: 48px;
    }

        .qty-cyber-group:focus-within,
        .qty-cyber-group:hover {
            border-color: var(--neon-teal);
            box-shadow: 0 0 14px rgba(93, 242, 214, 0.35);
        }

    .btn-qty-step {
        background: #121f21;
        border: none;
        color: var(--neon-teal);
        width: 40px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-qty-step:hover {
            background: var(--neon-teal);
            color: #080c0d;
        }

    .qty-input-detail {
        background: #121f21 !important; /* ĐÃ ĐỒNG BỘ CÙNG MÀU VỚI CÁC NÚT BÊN CẠNH */
        border: none !important;
        outline: none !important;
        color: #ffffff !important;
        width: 44px;
        height: 100%;
        text-align: center;
        font-weight: 800;
        font-size: 1.1rem;
        -moz-appearance: textfield;
    }

        .qty-input-detail::-webkit-outer-spin-button,
        .qty-input-detail::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .btn-add-to-cart-detail {
        background: rgba(93, 242, 214, 0.12);
        border: 1.5px solid var(--neon-teal);
        color: var(--neon-teal);
        font-weight: 700;
        height: 48px;
        padding: 0 20px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
    }

        .btn-add-to-cart-detail:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 20px rgba(93, 242, 214, 0.55);
            transform: translateY(-2px);
        }

    .btn-buy-detail {
        background: linear-gradient(135deg, #00897b, #004d40);
        border: 1.5px solid var(--neon-teal);
        color: #ffffff;
        font-weight: 700;
        height: 48px;
        padding: 0 24px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
    }

        .btn-buy-detail:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 22px rgba(93, 242, 214, 0.6);
            transform: translateY(-2px);
        }

    .btn-buy-disabled {
        background: #2b3a3c !important;
        border: 1px solid #4a5d60 !important;
        color: #7d8e91 !important;
        cursor: not-allowed !important;
    }

    .btn-login-to-buy {
        background: rgba(239, 68, 68, 0.15);
        border: 1.5px solid #f87171;
        color: #fca5a5;
        font-weight: 700;
        height: 48px;
        padding: 0 24px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.25s ease;
    }

        .btn-login-to-buy:hover {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 0 18px rgba(239, 68, 68, 0.6);
        }

    /* NÚT XEM SẢN PHẨM KHÁC (ĐỒNG BỘ CÙNG MÀU NEON TEAL) */
    .btn-view-other {
        background: rgba(93, 242, 214, 0.08);
        border: 1.5px solid var(--neon-teal);
        color: var(--neon-teal);
        font-weight: 700;
        height: 48px;
        padding: 0 20px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 14px;
        transition: all 0.25s ease;
        white-space: nowrap;
    }

        .btn-view-other:hover {
            background: var(--neon-teal);
            color: #080c0d;
            box-shadow: 0 0 16px rgba(93, 242, 214, 0.4);
            transform: translateY(-2px);
        }

    @@media (max-width: 992px) {
        .detail-card

    {
        padding: 20px;
    }

    .detail-title {
        font-size: 22px;
    }

    .detail-price {
        font-size: 26px;
    }

    .qty-cyber-group, .btn-add-to-cart-detail, .btn-buy-detail, .btn-login-to-buy, .btn-view-other {
        width: 100%;
    }

    }
</style>

<div class="container py-4">
    <!-- NÚT TRÒN QUAY LẠI BÊN TRÁI -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/Product" class="btn-back-circle" title="Quay lại cửa hàng">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h3 style="color: var(--neon-teal); font-weight: 800; margin: 0;">CHI TIẾT CẤU HÌNH MÁY</h3>
    </div>

    @if (Model != null)
    {
        <div class="detail-card">
            <div class="row align-items-center">
                <!-- HÌNH ẢNH SẢN PHẨM -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <div class="detail-img-box">
                        @if (stockVal <= 0)
                        {
                            <span class="detail-floating-stock stock-out">HẾT HÀNG</span>
                        }
                        else if (stockVal == 1)
                        {
                            <span class="detail-floating-stock stock-last-one">🔥 CÒN 1 MÁY</span>
                        }
                        else if (stockVal <= 3)
                        {
                            <span class="detail-floating-stock stock-low">CÒN @stockVal MÁY</span>
                        }
                        else
                        {
                            <span class="detail-floating-stock stock-available">CÒN HÀNG</span>
                        }

                        <img src="@finalImg" alt="@nameVal" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603302576837-37561b2e2302?w=600&q=80';" />
                    </div>
                </div>

                <!-- THÔNG TIN CHI TIẾT -->
                <div class="col-lg-7 ps-lg-4">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge-code">MÃ MÁY: #@idVal</span>
                        <span class="badge-category"><i class="bi bi-laptop me-1"></i>@categoryName</span>
                    </div>

                    <h1 class="detail-title">@nameVal</h1>

                    <div class="detail-price">
                        @string.Format("{0:N0} đ", priceVal)
                    </div>

                    <!-- THÔNG SỐ KỸ THUẬT -->
                    <div>
                        <div style="color: #5df2d6; font-weight: 700; font-size: 13.5px; margin-bottom: 8px; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-cpu-fill"></i> CẤU HÌNH &amp; THÔNG SỐ KỸ THUẬT:
                        </div>
                        <div class="specs-box">
                            @(string.IsNullOrWhiteSpace(specs) ? "Đang cập nhật thông số kỹ thuật chi tiết cho cấu hình máy này..." : specs)
                        </div>
                    </div>

                    <!-- KHUNG GIAO HÀNG -->
                    <div class="delivery-notice-box">
                        <strong class="title-region">
                            <i class="bi bi-geo-alt-fill me-1" style="color: var(--neon-teal);"></i> Tại Miền Nam &amp; TP.HCM:
                        </strong>
                        <ul>
                            <li><strong>Laptop Gaming &amp; Văn phòng:</strong> Giao hỏa tốc trong 2 giờ sau khi đặt hàng (8h00 – 16h00).</li>
                            <li><strong>PC Gaming &amp; Workstation:</strong> Kỹ thuật viên giao tận nơi, hỗ trợ lắp ráp, cắm nguồn và test màn hình miễn phí.</li>
                        </ul>
                        <strong class="title-region">
                            <i class="bi bi-truck me-1" style="color: var(--neon-teal);"></i> Tại Miền Bắc &amp; Các tỉnh khác:
                        </strong>
                        <ul>
                            <li>Giao hàng từ 8h00 – 16h00 qua đơn vị chuyển phát có bảo hiểm 100%, đóng thùng xốp chống sốc nguyên khối.</li>
                        </ul>
                        <div class="delivery-notice-note">
                            <i class="bi bi-clock-history me-1"></i> <strong>Lưu ý:</strong> Khách đặt hàng từ 8h00 – 16h00: kiểm tra phần cứng (burn-in test) và giao trong ngày.
                        </div>
                    </div>

                    <!-- KHU VỰC CHỌN SỐ LƯỢNG & CÁC NÚT THAO TÁC CÙNG HÀNG -->
                    @if (isLoggedIn)
                    {
                        if (stockVal > 0)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                                <input type="hidden" name="productId" value="@idVal" />
                                <input type="hidden" name="returnUrl" value="/Product/Detail/@idVal" />

                                <div class="qty-cyber-group">
                                    <button type="button" class="btn-qty-step" onclick="adjustProductQty(-1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="number" id="detailQuantity" name="quantity" class="qty-input-detail"
                                           value="1" min="1" max="@stockVal"
                                           oninput="validateManualQty(this, @stockVal)" />
                                    <button type="button" class="btn-qty-step" onclick="adjustProductQty(1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <button type="submit" name="buyNow" value="false" class="btn-add-to-cart-detail">
                                    <i class="bi bi-cart-plus-fill fs-5"></i> THÊM GIỎ HÀNG
                                </button>

                                <button type="submit" name="buyNow" value="true" class="btn-buy-detail">
                                    <i class="bi bi-lightning-charge-fill fs-5"></i> MUA NGAY
                                </button>

                                <a href="/Product" class="btn-view-other">
                                    <i class="bi bi-grid"></i> Xem sản phẩm khác
                                </a>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button type="button" class="btn-buy-detail btn-buy-disabled" disabled>
                                    <i class="bi bi-x-circle"></i> TẠM HẾT HÀNG
                                </button>
                                <a href="/Product" class="btn-view-other">
                                    <i class="bi bi-grid"></i> Xem sản phẩm khác
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Product/Detail/@idVal" class="btn-login-to-buy">
                                <i class="bi bi-box-arrow-in-right"></i> ĐĂNG NHẬP ĐỂ MUA HÀNG
                            </a>
                            <a href="/Product" class="btn-view-other">
                                <i class="bi bi-grid"></i> Xem sản phẩm khác
                            </a>
                        </div>
                        <div class="mt-2 small text-warning opacity-75">
                            <i class="bi bi-info-circle me-1"></i> Bạn cần đăng nhập tài khoản BMDTStore để tiếp tục đặt hàng.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<script>
    function adjustProductQty(delta) {
        const input = document.getElementById('detailQuantity');
        if (!input) return;

        let currentVal = parseInt(input.value) || 1;
        let minVal = parseInt(input.getAttribute('min')) || 1;
        let maxVal = parseInt(input.getAttribute('max')) || 9999;

        let targetVal = currentVal + delta;
        if (targetVal < minVal) targetVal = minVal;
        if (targetVal > maxVal) targetVal = maxVal;

        input.value = targetVal;
    }

    function validateManualQty(input, maxVal) {
        let val = parseInt(input.value);
        if (isNaN(val) || val < 1) {
            input.value = 1;
        } else if (val > maxVal) {
            input.value = maxVal;
        }
    }
</script>